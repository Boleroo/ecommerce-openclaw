{
  "name": "@local/openclaw-ecommerce-dispatcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "generate": "../mock-api/venv/bin/python ../scripts/generate_openclaw_tools.py",
    "build": "npm run generate && tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --root . --entry ./dist/index.js",
    "plugin:check": "npm run build && openclaw plugins build --root . --entry ./dist/index.js --check",
    "plugin:validate": "npm run build && openclaw plugins validate --root . --entry ./dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "typebox": "1.3.3"
  },
  "devDependencies": {
    "openclaw": "2026.7.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1 <2027"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1",
      "pluginSdkVersion": "2026.7.1"
    }
  }
}
